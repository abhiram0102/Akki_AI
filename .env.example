# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/ai_copilot"
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="ai_copilot"
PGUSER="username"
PGPASSWORD="password"

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key-here"

# Google AI Configuration (optional, for Gemini support)
GOOGLE_API_KEY="your-google-api-key-here"

# JWT Secret for authentication
JWT_SECRET="your-jwt-secret-key-here"

# Vector Database Configuration
CHROMA_URL="http://localhost:8000"

# Production environment variables
NODE_ENV="development"
PORT="5000"

# Replit specific (if deploying on Replit)
REPLIT_DB_URL=""

# Langfuse Tracing (optional — activate by filling in all three keys)
# Sign up at https://cloud.langfuse.com to get your project keys.
# When LANGFUSE_PUBLIC_KEY is unset, the tracer runs as a silent no-op.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
