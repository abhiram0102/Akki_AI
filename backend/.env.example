# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://akki:changeme@localhost:5432/akki_ai

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET=your-strong-random-secret-at-least-32-characters-long

# ── Google Gemini AI ──────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Ollama (optional — local LLM) ────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Cloudflare AI (optional — custom hosted models) ───────────────────────
CLOUDFLARE_AI_URL=your-cloudflare-ai-url
CLOUDFLARE_CHAT_MODEL=your-chat-model
CLOUDFLARE_CODE_MODEL=your-code-model
CLOUDFLARE_REDTEAM_MODEL=your-redteam-model
CLOUDFLARE_EMBED_MODEL=your-embed-model

# ── Langfuse (optional — LLM tracing) ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Tavily (optional — web search for CRAG) ──────────────────────────────
TAVILY_API_KEY=

# ── Embedding Provider ────────────────────────────────────────────────────
# Options: 'ollama', 'cloudflare', 'none' (text search fallback)
EMBEDDING_PROVIDER=none

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000

# ── VirusTotal (optional — reputation intel) ──────────────────────────────────
VIRUSTOTAL_API_KEY=

# ── Censys (optional — internet asset discovery) ─────────────────────────────
CENSYS_API_ID=
CENSYS_API_SECRET=
