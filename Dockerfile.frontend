# ── AKKI AI — Frontend (Vite build → Nginx) ──────────────────────────────────

# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy lock files first — layer cache only invalidates when deps change
COPY package.json package-lock.json ./

# npm ci respects package-lock.json exactly and allows build scripts (unlike pnpm 10)
RUN npm ci --silent

# Copy all source needed for the Vite build
COPY client/        ./client/
COPY tailwind.config.ts postcss.config.js tsconfig.json vite.config.ts ./

# Production build — output lands in dist/public per vite.config.ts
ENV NODE_ENV=production
RUN npm run build

# ── Stage 2: Serve with Nginx ─────────────────────────────────────────────────
FROM nginx:1.25-alpine

# Remove default server block
RUN rm /etc/nginx/conf.d/default.conf

# Install curl for healthcheck
RUN apk add --no-cache curl

COPY nginx.conf                  /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/public /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost/index.html || exit 1

CMD ["nginx", "-g", "daemon off;"]
